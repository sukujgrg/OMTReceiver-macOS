MACOSX_DEPLOYMENT_TARGET = 14.0
SDKROOT = macosx
ARCHS = arm64
SWIFT_VERSION = 5.0
SWIFT_STRICT_CONCURRENCY = targeted
CLANG_ENABLE_MODULES = YES
CLANG_ENABLE_OBJC_ARC = YES
GCC_C_LANGUAGE_STANDARD = gnu17
ENABLE_HARDENED_RUNTIME = YES
COPY_PHASE_STRIP = NO
ENABLE_USER_SCRIPT_SANDBOXING = NO
PRODUCT_BUNDLE_IDENTIFIER = com.suku.OMTReceiver-macOS
PRODUCT_NAME = OMTReceiver
INFOPLIST_FILE = $(DERIVED_FILE_DIR)/OMTReceiver-Info.plist
GENERATE_INFOPLIST_FILE = NO
SWIFT_OBJC_BRIDGING_HEADER = OMTReceiver/Transport/OMTReceiver-Bridging-Header.h
HEADER_SEARCH_PATHS = $(inherited) "$(OMT_SDK_ROOT)/include" "$(SRCROOT)/OMTReceiver/Transport"
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks @executable_path/../Frameworks/OMT
CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM = E5N29VFW8T
CODE_SIGN_IDENTITY = Apple Development
ENABLE_APP_SANDBOX = NO
CURRENT_PROJECT_VERSION =
RELEASE_SOURCE_COMMIT =
// Override local signing in the untracked file below when needed.
#include? "Signing.local.xcconfig"
OMT_SDK_ROOT = $(SRCROOT)/Vendor/OMT
